<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAILWAY RANK MITRA</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f5f9;color:#172033}
header{background:linear-gradient(135deg,#10234f,#1769aa);color:white;padding:25px 16px;text-align:center}
header h1{margin:0;font-size:27px}
header p{margin:9px 0 0;font-size:14px}
nav{display:flex;gap:8px;justify-content:center;padding:14px;flex-wrap:wrap;background:white}
button{cursor:pointer;border:0;border-radius:9px;padding:12px 16px;font-weight:bold}
nav button{background:#e3edff;color:#123d75}
nav button.active,.primary{background:#1769e0;color:white}
.container{max-width:850px;margin:20px auto;padding:0 13px}
.card{background:white;border-radius:15px;padding:20px;margin-bottom:16px;box-shadow:0 3px 15px #17203310}
.card h2{margin-top:0;color:#173e75;font-size:21px}
label{display:block;font-weight:bold;font-size:14px;margin:13px 0 6px}
input,select{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:8px;font-size:15px;background:white}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.full{grid-column:1/-1}
.primary{width:100%;margin-top:18px;font-size:16px}
.result{display:none;background:#e9f8ef;border:1px solid #a7e4bd;padding:18px;border-radius:12px;margin-top:18px}
.score{font-size:34px;font-weight:bold;color:#087443}
.small{font-size:13px;line-height:1.6;color:#5b6473}
footer{text-align:center;padding:22px;background:#10234f;color:white;margin-top:30px}
.badge{display:inline-block;padding:6px 10px;background:#fff1cf;color:#875500;border-radius:20px;font-size:12px;font-weight:bold}
@media(max-width:520px){.grid{grid-template-columns:1fr}.full{grid-column:auto}header h1{font-size:23px}.card{padding:16px}}
</style>
</head>

<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Railway Rank Mitra</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#eef3f9;
  color:#172033;
}
header{
  background:linear-gradient(135deg,#073b73,#087fbd);
  color:white;
  text-align:center;
  padding:25px 12px;
}
header h1{margin:0 0 10px;font-size:27px}
header p{margin:0;font-size:14px}
.container{max-width:650px;margin:20px auto;padding:0 12px}
.card{
  background:white;
  padding:20px;
  margin-bottom:18px;
  border-radius:14px;
  box-shadow:0 3px 12px #00000012;
}
h2{font-size:20px;color:#07549b;margin-top:0}
label{display:block;margin-top:12px;font-weight:bold}
input,select{
  width:100%;
  padding:12px;
  margin-top:6px;
  border:1px solid #cbd5e1;
  border-radius:8px;
  font-size:16px;
  background:white;
}
button{
  width:100%;
  padding:13px;
  margin-top:16px;
  border:0;
  border-radius:8px;
  background:#0866c6;
  color:white;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
}
button:hover{background:#064c94}
.result{
  margin-top:15px;
  padding:14px;
  border-radius:8px;
  background:#e5f5e9;
  color:#14532d;
  font-weight:bold;
  line-height:1.8;
  overflow-wrap:anywhere;
}
.note{font-size:13px;color:#64748b;line-height:1.6}
footer{
  text-align:center;
  padding:20px;
  color:#64748b;
  font-size:13px;
}
</style>
</head>

<body>

<header>
  <h1>🚆 RAILWAY RANK MITRA</h1>
  <p>Railway Exams की तैयारी का साथी</p>
  <p>Answer Key • Rank Calculator • Response Sheet</p>
</header>

<div class="container">

  <section class="card">
    <h2>📝 Answer Key Calculator</h2>

    <label>कुल प्रश्न</label>
    <input type="number" id="total" min="0" placeholder="जैसे 100">

    <label>सही प्रश्न</label>
    <input type="number" id="correct" min="0" placeholder="जैसे 75">

    <label>गलत प्रश्न</label>
    <input type="number" id="wrong" min="0" placeholder="जैसे 15">

    <label>हर सही उत्तर के अंक</label>
    <input type="number" id="positive" value="1" step="0.01">

    <label>हर गलत उत्तर पर कटने वाले अंक</label>
    <input type="number" id="negative" value="0.33" min="0" step="0.01">

    <button onclick="calculateMarks()">Calculate Marks</button>
    <div id="marksResult" class="result" hidden></div>
  </section>

  <section class="card">
    <h2>🏆 Rank Calculator</h2>

    <label>आपके प्राप्त अंक</label>
    <input type="number" id="myMarks" min="0" step="0.01"
           placeholder="अपने अंक डालें">

    <label>कुल उम्मीदवार</label>
    <input type="number" id="candidates" min="1"
           placeholder="जैसे 100000">

    <label>आपका अनुमानित Percentile (%)</label>
    <input type="number" id="percentile" min="0" max="100"
           step="0.01" placeholder="जैसे 95">

    <button onclick="calculateRank()">Estimate Rank</button>
    <div id="rankResult" class="result" hidden></div>

    <p class="note">
      नोट: यह अनुमानित रैंक है। वास्तविक रैंक परीक्षा के परिणाम,
      नॉर्मलाइजेशन और अन्य उम्मीदवारों के प्रदर्शन पर निर्भर करती है।
    </p>
  </section>

  <section class="card">
    <h2>📄 Response Sheet PDF</h2>

    <label>अपनी Response Sheet PDF चुनें</label>
    <input type="file" id="pdfFile" accept="application/pdf">

    <button onclick="openPDF()">Open Response Sheet</button>
    <div id="pdfResult" class="result" hidden></div>

    <p class="note">
      PDF आपके ब्राउज़र में खोली जाएगी। यह वेबसाइट आपकी PDF
      को सर्वर पर अपलोड नहीं करती।
    </p>
  </section>

</div>

<footer>
  © 2026 Railway Rank Mitra | All Rights Reserved
</footer>

<script>
function getNumber(id) {
  return Number(document.getElementById(id).value);
}

function calculateMarks() {
  const total = getNumber("total");
  const correct = getNumber("correct");
  const wrong = getNumber("wrong");
  const positive = getNumber("positive");
  const negative = getNumber("negative");

  const box = document.getElementById("marksResult");
  box.hidden = false;

  if (
    document.getElementById("total").value === "" ||
    document.getElementById("correct").value === "" ||
    document.getElementById("wrong").value === "" ||
    total < 0 || correct < 0 || wrong < 0 ||
    positive < 0 || negative < 0 ||
    correct + wrong > total
  ) {
    box.textContent =
      "कृपया सही जानकारी भरें। सही और गलत प्रश्नों का योग कुल प्रश्नों से अधिक नहीं होना चाहिए।";
    return;
  }

  const unattempted = total - correct - wrong;
  const marks = correct * positive - wrong * negative;

  box.innerHTML =
    "✅ प्राप्त अंक: " + marks.toFixed(2) +
    "<br>✔️ सही उत्तर: " + correct +
    "<br>❌ गलत उत्तर: " + wrong +
    "<br>⭕ बिना प्रयास: " + unattempted;
}

function calculateRank() {
  const marksField = document.getElementById("myMarks");
  const candidatesField = document.getElementById("candidates");
  const percentileField = document.getElementById("percentile");
  const box = document.getElementById("rankResult");

  const marks = getNumber("myMarks");
  const candidates = getNumber("candidates");
  const percentile = getNumber("percentile");

  box.hidden = false;

  if (
    marksField.value === "" ||
    candidatesField.value === "" ||
    percentileField.value === "" ||
    marks < 0 || candidates < 1 ||
    percentile < 0 || percentile > 100
  ) {
    box.textContent = "कृपया सभी जानकारी सही भरें।";
    return;
  }

  const rank = Math.max(
    1,
    Math.ceil(candidates * (100 - percentile) / 100)
  );

  box.innerHTML =
    "आपके अंक: " + marks +
    "<br>अनुमानित Percentile: " + percentile + "%" +
    "<br>अनुमानित Rank: " + rank.toLocaleString("en-IN");
}

let pdfURL = null;

function openPDF() {
  const input = document.getElementById("pdfFile");
  const box = document.getElementById("pdfResult");
  box.hidden = false;

  if (!input.files || !input.files[0]) {
    box.textContent = "पहले अपनी Response Sheet PDF चुनें।";
    return;
  }

  const file = input.files[0];

  if (file.type !== "application/pdf") {
    box.textContent = "कृपया PDF फाइल ही चुनें।";
    return;
  }

  if (pdfURL) {
    URL.revokeObjectURL(pdfURL);
  }

  pdfURL = URL.createObjectURL(file);

  box.innerHTML = "";

  const link = document.createElement("a");
  link.href = pdfURL;
  link.target = "_blank";
  link.rel = "noopener";
  link.textContent = "📄 PDF खोलने के लिए यहाँ टैप करें";
  link.style.color = "#07549b";
  link.style.fontWeight = "bold";

  box.appendChild(link);
}
</script>

</body>
</html>
